{
  "name": "hmoney",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:firebase": "VITE_STORAGE_DRIVER=firestore playwright test",
    "test:e2e:prod": "playwright test --project=production",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:cleanup": "tsx e2e/cleanup.ts",
    "test:e2e:full": "pnpm run test:e2e; pnpm run test:e2e:cleanup"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "firebase": "^12.19.0",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.7",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.4.0",
    "jsdom": "^30.0.1",
    "preact": "^10.29.8",
    "react": "file:./vendor/react-shim",
    "react-dom": "file:./vendor/react-dom-shim",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
