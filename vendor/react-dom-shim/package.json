{
  "name": "react-dom",
  "version": "19.3.0",
  "description": "Shim: react-dom -> preact/compat (anti vendor-lock, dev/CI only)",
  "private": true,
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.mjs"
    },
    "./package.json": "./package.json"
  }
}
